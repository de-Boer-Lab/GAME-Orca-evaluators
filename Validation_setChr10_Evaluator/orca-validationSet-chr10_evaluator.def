Bootstrap: docker
From: python:3.13-slim
Stage: build

%files
    ./config.py /Validation_setChr10_Evaluator/config.py
    ./data_loader.py /Validation_setChr10_Evaluator/data_loader.py
    ./evaluator_content_handler.py /Validation_setChr10_Evaluator/evaluator_content_handler.py 
    ./evaluator_metrics_calculator.py /Validation_setChr10_Evaluator/evaluator_metrics_calculator.py
    ./evaluator_RestAPI.py /Validation_setChr10_Evaluator/evaluator_RestAPI.py

%environment
    # Prevent automatic binding of host directories
    export APPTAINER_NO_MOUNT="home,tmp,proc,sys,dev"
    export LC_ALL=C
    export PATH="/opt/conda/envs/orca_env/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/conda/envs/orca_env/lib:$LD_LIBRARY_PATH"
    # seqstr env variable to get sequence
    export GENOME_PATH='/orca/resources/'
%post

    echo "Installing system dependencies..."
    apt-get update && \
    apt-get install -y --no-install-recommends git wget bzip2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    echo "Installing Miniconda..."
    mkdir -p /opt && \
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /opt/miniconda.sh && \
    chmod +x /opt/miniconda.sh
    bash /opt/miniconda.sh -b -p /opt/conda && \
    rm -rf /opt/miniconda.sh

    # echo "Installing mamba..."
    export PATH="/opt/conda/bin:$PATH"
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    conda install -y -n base -c conda-forge mamba
    . /opt/conda/etc/profile.d/mamba.sh

    echo "Getting orca repo..."
    cd /
    git clone https://github.com/jzhoulab/orca.git
    cd orca

    echo "Creating Conda environment 'orca_env'..."
    # conda clean --all --yes
    mamba env create -f orca_env_part1.yml -y
    mamba activate orca_env

    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118
    pip install flask msgpack msgpack_numpy requests
    mamba env update -f orca_env_part2.yml -y

    git clone https://github.com/kathyxchen/selene.git
    cd selene
    git checkout custom_target_support
    python setup.py build_ext --inplace
    python setup.py install 

    echo "Verifying Conda environment creation..."
    if ! conda env list | grep -q orca_env; then
        echo "Error: Conda environment 'orca' was not created successfully."
        exit 1
    fi

    echo "getting target values and hg38 reference genome"
    cd /orca
    wget https://zenodo.org/record/6234936/files/resources_core.tar.gz
    tar -xf resources_core.tar.gz --no-same-owner
    rm resources_core.tar.gz
    # target files, around 34G
    wget https://zenodo.org/record/6234936/files/resources_mcools.tar.gz 
    tar -xf resources_mcools.tar.gz --no-same-owner
    rm resources_mcools.tar.gz

    # these files will be copied after testing
    mkdir /scripts
    echo "Setting permissions for directories and script..."
    chmod -R 755 /scripts /opt/conda
    chmod +x /opt/conda/envs/orca_env/bin/python
    chmod -R 755 /Validation_setChr10_Evaluator

%runscript
    export PATH="/opt/conda/envs/orca_env/bin:$PATH"
    exec python /Validation_setChr10_Evaluator/evaluator_RestAPI.py "$@"

%startscript
    export PATH="/opt/conda/envs/orca_env/bin:$PATH"
    exec python /Validation_setChr10_Evaluator/evaluator_RestAPI.py "$@"

%labels
    Author "Rui Guo with edits from Ishika Luthra and Satyam Priyadarshi"
    game_schema_version "1.0"
    Description "This container is the Validation Set Chr10 Evaluator set up using the Genomic API for Model Evaluation framework."

%help
    Validation Set Chr10 Evaluator for the GAME framework (ORCA 1M Predictor).

    About this evaluator:
    Tiles human chromosome 10 (GRCh38, the ORCA held-out validation set) into 1 Mb windows,
    fetches each hg38 sequence at runtime, and requests interaction_matrix predictions of 3D 
    chromatin conformation. Each predicted 250x250 H1-ESC contact matrix is compared against
    the measured Hi-C target via Pearson r, enabling standardized evaluation of genomic 
    models on chromatin conformation.

    This container includes:
    - Evaluator API script for genomic sequence evaluation
    - Evaluator utility scripts (data loading, content negotiation, metrics calculation)
    - Installed Python dependencies required by the Evaluator

    Built on the Orca eval base (test.sif): orca_env, CUDA 11.8 torch, seqstr,
    and the resources_core + resources_mcools target data under /orca/resources.

    Mount the data and output directories at runtime:
        apptainer run --nv \
            -B /path/to/Validation_setChr10_Evaluator/evaluator_data:/evaluator_data \
            -B /path/to/predictions:/predictions \
            orca-validationSet-chr10_evaluator.sif <predictor_ip> <predictor_port> /predictions

    - `--nv` exposes the host GPU (the evaluator recomputes Hi-C targets via Orca)
    - `/evaluator_data` must contain `chr10_sequence_coordinates.json`
    - The third argument is the in-container output path (the mount target above).
